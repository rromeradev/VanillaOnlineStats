{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plugin telemetry envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "messageId", "serverId", "type", "source", "occurredAt", "sentAt", "payload"],
  "properties": {
    "schemaVersion": {"const": 1},
    "messageId": {"type": "string", "format": "uuid"},
    "serverId": {"type": "string", "format": "uuid"},
    "type": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9.-]{1,127}$"},
    "source": {"enum": ["paper-api", "authme-api", "jvm-filesystem", "paper-api+jvm", "derived"]},
    "occurredAt": {"type": "string", "format": "date-time"},
    "sentAt": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  }
}
