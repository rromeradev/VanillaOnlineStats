# Coolify 4.5.3: exemplos e campos reconhecidos pelo docker-compose.yml.
# Nao precisa criar .env no repositorio: preencha no Coolify.

# MANUAIS: iniciam vazios. Exemplo APP_ORIGIN=https://stats.rromera.dev
APP_ORIGIN=
# Exemplo VOS_ADMIN_EMAIL=voce@exemplo.com
VOS_ADMIN_EMAIL=

# AUTOMATICAS PELO COOLIFY: deixe o Coolify gerar e preserve entre deploys.
# Senha PostgreSQL e senha inicial Owner (32 caracteres, sem simbolos).
SERVICE_PASSWORD_DATABASE=
SERVICE_PASSWORD_OWNER=
# Chave de dados: Base64 de 32 bytes reais; segredo de sessao: 64 caracteres.
SERVICE_REALBASE64_32_DATA=
SERVICE_BASE64_64_SESSION=

# AUTOMATICAS PELA APLICACAO: vazias geram UUID e Ed25519 no volume identity.
# Na migracao, informe os valores da instalacao existente antes do primeiro deploy.
VOS_TENANT_ID=
VOS_CONTROL_PRIVATE_KEY=
